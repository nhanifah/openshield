# Copy to .env and fill in what you use. Never commit .env.
# Every value is optional: without them OpenShield still runs, creates its
# own secret key file, and prints a first-run setup token for the dashboard.

# Key that encrypts secrets saved from the dashboard (AI key, Turnstile
# secret, policy versions): 32 random bytes, base64. Generate with
#   openssl rand -base64 32
# If unset, a key file (openshield-secret.key, mode 0600) is created next to
# the database. Back up whichever you use: without it, saved secrets are lost.
OPENSHIELD_SECRET_KEY=

# Google AI Studio (Gemini) key for AI analysis, read from the variable named
# by intel.ai.api_key_env. You can instead enter it under Settings, AI in the
# dashboard, where it is stored encrypted.
GEMINI_API_KEY=

# Admin tokens for users defined in the config file with
#   admin.users: [{name: alice, role: admin, token_env: OPENSHIELD_ADMIN_TOKEN}]
# At least 16 characters; generate with  openssl rand -hex 32
# Users created in the dashboard need no variable.
OPENSHIELD_ADMIN_TOKEN=

# Log level for the proxy's own messages (not the access/audit logs).
RUST_LOG=openshield=info,pingora=info
